<?xml version="1.0" encoding="utf-8"?>
<!-- App shortcut icon from Android 8 on: an adaptive icon, so the launcher fills its whole shape with the launcher
     icon's mauve instead of putting the icon on a white disc; the glyph is the prototype's (app/js/ui/icons.js). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_shortcut_dictate_foreground" />
</adaptive-icon>
