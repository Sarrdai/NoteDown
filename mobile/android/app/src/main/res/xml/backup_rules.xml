<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier (allowBackup is false already; this also covers adb backup and OEM tools that
     honour the rules): nothing of NoteDown is backed up (backlog #39). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
