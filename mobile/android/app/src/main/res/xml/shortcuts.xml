<?xml version="1.0" encoding="utf-8"?>
<!-- The app shortcuts on a long-press of the app icon (docs/requirements.md → "Quick capture"). Their target
     QuickCaptureActivity hands the action on to MainActivity (QuickCapturePlugin). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_note"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_note"
        android:shortcutShortLabel="@string/shortcut_new_note">
        <intent
            android:action="io.github.sarrdai.notedown.NEW_NOTE"
            android:targetPackage="io.github.sarrdai.notedown"
            android:targetClass="io.github.sarrdai.notedown.QuickCaptureActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="dictate"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_dictate"
        android:shortcutShortLabel="@string/shortcut_dictate">
        <intent
            android:action="io.github.sarrdai.notedown.DICTATE"
            android:targetPackage="io.github.sarrdai.notedown"
            android:targetClass="io.github.sarrdai.notedown.QuickCaptureActivity" />
    </shortcut>
</shortcuts>
